#!/usr/bin/make -f

export DH_VERBOSE = 1
export CGO_ENABLED = 1

%:
	dh $@

override_dh_auto_build:
	go build -v \
		-ldflags "-X github.com/slicingmelon/gobypass403/core/cli.GOBYPASS403_VERSION=$$(dpkg-parsechangelog -SVersion) -s -w" \
		-o gobypass403 \
		./cmd/gobypass403

override_dh_auto_clean:
	rm -f gobypass403

override_dh_auto_test:
	true
